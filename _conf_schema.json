{
  "default_provider": {
    "description": "默认生图渠道",
    "type": "string",
    "hint": "不写渠道名时使用该渠道，例如 /draw 一只橘猫。各渠道的地址、密钥、模型和参数均在本配置表单中设置。",
    "obvious_hint": true,
    "default": "gpt",
    "options": [
      "gpt",
      "gemini",
      "comfyui",
      "seedream",
      "grok",
      "jimeng",
      "qwen"
    ]
  },
  "test_connection_on_save": {
    "description": "保存后测试连通性",
    "type": "bool",
    "hint": "开启后，保存配置触发的热重载、手动重载及启动时测试各渠道连接与延迟。完成后重新打开配置，查看下方最近测试时间和结果；结果框可拖动放大。仅 GET 只读请求，不生成图片；单渠道最长 15 秒，最多并发 3 个。关闭后保留上次结果。",
    "obvious_hint": true,
    "default": false
  },
  "connection_test_time": {
    "description": "最近测试时间",
    "type": "string",
    "hint": "自动记录最近一次完成测试的服务器时间，含时区。测试后重新打开配置查看；无需手动填写。",
    "default": "尚未测试"
  },
  "connection_test_result": {
    "description": "最近一次测试结果",
    "type": "text",
    "hint": "自动记录各渠道状态、延迟、HTTP 状态及失败原因，不显示地址或密钥。测试后重新打开配置查看，结果框可拖动放大；无需手动填写。连接通过不保证生图权限可用。",
    "obvious_hint": true,
    "default": "尚未测试。开启“保存后测试连通性”并保存，完成后重新打开配置查看结果。"
  },
  "generation_feedback": {
    "description": "生成进度与结果提示",
    "type": "bool",
    "hint": "开启后在聊天中提示正在生成，完成后显示总耗时、实际尺寸及像素请求不一致的情况。为核验尺寸会下载 URL 图片并使用原有缓存策略发送；核验失败时保留原链接并提示尺寸未能核验。默认关闭。",
    "default": false
  },
  "max_count": {
    "description": "单次最多生成数量",
    "type": "int",
    "hint": "防止用户用 --n 参数一次请求过多图片",
    "default": 4
  },
  "enable_reference": {
    "type": "bool",
    "default": true,
    "invisible": true
  },
  "max_references": {
    "description": "参考图数量上限（0 关闭图生图）",
    "type": "int",
    "hint": "设为 0 时不读取参考图、不启用图生图；大于 0 时最多读取指定数量的参考图。",
    "default": 3
  },
  "reference_max_mb": {
    "description": "单张参考图大小上限（MB）",
    "type": "int",
    "default": 8
  },
  "use_file_service": {
    "description": "把本地参考图注册到 AstrBot 回调文件服务",
    "type": "bool",
    "hint": "即梦等只接受图片 URL 的接口需要开启；需要 AstrBot 已配置 callback_api_base",
    "default": false
  },
  "admin_only": {
    "description": "仅管理员可用",
    "type": "bool",
    "hint": "开启后只有管理员能用（优先于下面所有群名单判断）",
    "default": false
  },
  "admin_bypass": {
    "description": "管理员绕过限制",
    "type": "bool",
    "hint": "开启后，AstrBot 管理员（主配置 admins_id 里的号）不受下面四个名单与频率限制的约束；普通成员照常受限。默认关闭",
    "default": false
  },
  "rate_limit_enabled": {
    "description": "启用频率限制",
    "type": "bool",
    "hint": "⚠️ 建议开启：生图是真金白银的调用，群里连刷会很快把额度烧完。默认关闭是为了不改变既有行为",
    "default": false
  },
  "rate_limit_scope": {
    "description": "限制维度",
    "type": "string",
    "hint": "user=每人独立计数（推荐，更公平）；group=整个群共用一个额度（更省额度）。私聊一律按人算",
    "default": "user",
    "options": [
      "user",
      "group"
    ]
  },
  "rate_limit_window_minutes": {
    "description": "统计窗口（分钟）",
    "type": "int",
    "default": 10
  },
  "rate_limit_max_calls": {
    "description": "窗口内最多生成几次",
    "type": "int",
    "hint": "只有成功受理的调用才计数；被限流的重试不会把窗口往后推",
    "default": 5
  },
  "group_whitelist": {
    "description": "群白名单",
    "type": "list",
    "hint": "只有名单内的群可用。⚠️ 与「群黑名单」只能填一个：本项非空时黑名单不生效；群黑名单非空时本项不生效。两者都留空则不对群做限制",
    "default": []
  },
  "group_blacklist": {
    "description": "群黑名单",
    "type": "list",
    "hint": "名单内的群不可用。⚠️ 本项非空时「群白名单」不生效，且「群内个人黑白名单」整体不生效",
    "default": []
  },
  "group_user_whitelist": {
    "description": "群内个人白名单",
    "type": "dict",
    "items": {},
    "hint": "键=群号，值=允许使用的成员号数组，例如 {\"123456\": [\"10001\", \"10002\"]}。⚠️ 只在群白名单/群黑名单都留空时才生效；同一群里本项与「群内个人黑名单」只填一个",
    "default": {}
  },
  "group_user_blacklist": {
    "description": "群内个人黑名单",
    "type": "dict",
    "items": {},
    "hint": "键=群号，值=禁止使用的成员号数组，例如 {\"123456\": [\"10001\"]}。⚠️ 只在群白名单/群黑名单都留空时才生效；同一群里本项非空时该群的白名单不生效",
    "default": {}
  },
  "one_task_per_session": {
    "description": "同一会话同时只允许一个生图任务",
    "type": "bool",
    "default": true
  },
  "cache_keep_minutes": {
    "description": "本地图片缓存保留时长（分钟）",
    "type": "int",
    "hint": "填 0 表示不自动清理",
    "default": 30
  },
  "gpt": {
    "description": "GPT / OpenAI 兼容渠道（通用位）",
    "type": "object",
    "hint": "这是「通用 OpenAI 兼容位」：只要对方提供 OpenAI 协议的 /v1/images/generations（或退一步 /v1/chat/completions 能出图），不管背后实际是 GPT、FLUX、Stable Diffusion 还是别的模型，都填这里，无需改代码。官方 OpenAI 填 https://api.openai.com，中转站/第三方填其地址",
    "items": {
      "parameter_preset": {
        "description": "常用参数预设",
        "type": "string",
        "hint": "尺寸统一在此选择：场景预设、手动宽高，或当前模型与协议支持的原生档位／比例。模型自适应不换算成固定像素。更换模型或协议后，保存并重新打开配置以刷新选项；命令尺寸优先。",
        "default": "custom",
        "options": [
          "avatar",
          "portrait",
          "landscape",
          "wallpaper",
          "cover",
          "custom"
        ],
        "labels": [
          "头像方图 · 1:1",
          "竖版人像 · 3:4",
          "横版插画 · 4:3",
          "手机壁纸 · 9:16",
          "宽屏封面 · 16:9",
          "手动宽高"
        ]
      },
      "native_resolution": {
        "description": "模型分辨率档位",
        "type": "string",
        "default": "",
        "options": [
          ""
        ],
        "labels": [
          "模型默认"
        ],
        "condition": {
          "parameter_preset": "native"
        },
        "invisible": true,
        "hint": "仅提供当前已保存模型与协议支持的档位。2K、4K 原样发送给模型，不代表固定宽高；历史未知档位保留供核对。"
      },
      "native_ratio": {
        "description": "模型画面比例",
        "type": "string",
        "default": "",
        "options": [
          "",
          "1:1",
          "4:3",
          "3:4",
          "16:9",
          "9:16",
          "3:2",
          "2:3",
          "21:9"
        ],
        "labels": [
          "模型默认",
          "1:1",
          "4:3",
          "3:4",
          "16:9",
          "9:16",
          "3:2",
          "2:3",
          "21:9"
        ],
        "condition": {
          "parameter_preset": "native"
        },
        "invisible": true,
        "hint": "仅在模型自适应模式生效。Seedream 的比例按提示词决定，不提供独立比例参数；模型或平台仍可能限制支持范围。"
      },
      "dimensions": {
        "description": "手动宽高（宽:高）",
        "type": "string",
        "default": "0:0",
        "condition": {
          "parameter_preset": "custom"
        },
        "hint": "填写像素宽度:像素高度，例如 1080:1920 表示宽 1080、高 1920。0:0 表示未指定；只填一边时可用 1080:0，另一边回退为 1024。只在“手动宽高”模式生效，命令参数优先；模型可能限制可用尺寸。"
      },
      "width": {
        "type": "int",
        "default": 0,
        "invisible": true
      },
      "height": {
        "type": "int",
        "default": 0,
        "invisible": true
      },
      "api_base": {
        "description": "API 地址",
        "type": "string",
        "hint": "可填 https://api.openai.com、https://api.openai.com/v1，或中转站/第三方服务的 https://xxx.com/v1",
        "default": "https://api.openai.com"
      },
      "api_key": {
        "description": "API Key",
        "type": "string",
        "default": "",
        "secret": true,
        "obvious_hint": true
      },
      "model": {
        "description": "模型名称",
        "type": "string",
        "hint": "保存 API 地址和 Key 后自动读取生图模型目录，完成后重新打开配置，可在此直接选择并保存。读取失败或暂无候选时保留输入框；启用下方手动填写开关并保存后可输入自定义模型。目录可见不保证余额或生图权限。",
        "default": "gpt-image-1"
      },
      "manual_model_input": {
        "description": "手动填写模型名称",
        "type": "bool",
        "hint": "开启并保存后重新打开配置，模型名称改为手动输入；关闭并保存后恢复自动读取生图模型下拉。此开关不修改已保存的模型。",
        "default": false
      },
      "size": {
        "type": "string",
        "default": "",
        "invisible": true
      },
      "api_style": {
        "description": "调用协议",
        "type": "string",
        "hint": "auto=先试图片接口再回退对话接口；images=只用 /images/generations；chat=只用 /chat/completions",
        "default": "auto",
        "options": [
          "auto",
          "images",
          "chat"
        ]
      },
      "timeout": {
        "description": "请求超时（秒）",
        "type": "int",
        "default": 180,
        "hint": "仅作用于本渠道的单次 HTTP 请求，生图较慢时可调大；异步任务总等待时长由本渠道的最长等待时间单独控制（若有该项）。"
      },
      "extra_headers": {
        "description": "附加请求头",
        "type": "dict",
        "items": {},
        "hint": "自建中转站需要自定义鉴权头时填写，例如 {\"X-Api-Key\":\"xxx\"}",
        "default": {}
      },
      "extra_body": {
        "description": "扩展请求参数",
        "type": "dict",
        "items": {},
        "hint": "仅补充没有专门配置项的扩展字段，例如 quality、response_format。模型、提示词、参考图、尺寸、原生分辨率、数量、种子和已提供专门设置的字段会被忽略；不能覆盖正式配置。支持 parameters、generationConfig、imageConfig 中的扩展字段；百炼扩展字段直接填写在此，插件会放入 parameters。",
        "default": {}
      },
      "proxy": {
        "description": "HTTP(S) 代理",
        "type": "string",
        "hint": "例如 http://127.0.0.1:7890",
        "default": ""
      },
      "verify_ssl": {
        "description": "校验 TLS 证书",
        "type": "bool",
        "hint": "自建自签名站点可关闭",
        "default": true
      },
      "force_download": {
        "description": "强制代为下载图片",
        "type": "bool",
        "default": false,
        "hint": "仅作用于本渠道。图片链接需要鉴权时开启，由插件下载成本地文件发送；鉴权头只发送到与本渠道 API 同源的地址。"
      },
      "size_settings_version": {
        "type": "int",
        "default": 0,
        "invisible": true
      }
    }
  },
